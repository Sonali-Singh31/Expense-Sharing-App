// This is your Prisma schema file.
// In Prisma 7, the URL is managed via prisma.config.ts and adapters.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  // Note: 'url' is removed here to comply with Prisma 7.x requirements.
  // The connection string is now handled in prisma.config.ts.
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  name           String
  password       String    // Added for Auth requirements
  groups         Group[]   @relation("GroupMembers")
  paidExpenses   Expense[] @relation("Payer")
  splits         Split[]   @relation("Ower")
}

model Group {
  id        String    @id @default(uuid())
  name      String
  members   User[]    @relation("GroupMembers")
  expenses  Expense[]
}

model Expense {
  id          String   @id @default(uuid())
  description String
  totalAmount Float
  createdAt   DateTime @default(now())
  
  // Split logic requirements: EQUAL, EXACT, PERCENTAGE
  splitType   String   
  
  // Relations
  paidBy      User     @relation("Payer", fields: [paidById], references: [id])
  paidById    String
  group       Group    @relation(fields: [groupId], references: [id])
  groupId     String
  splits      Split[]  @relation("ExpenseSplits")
}

model Split {
  id         String   @id @default(uuid())
  expense    Expense  @relation("ExpenseSplits", fields: [expenseId], references: [id])
  expenseId  String
  user       User     @relation("Ower", fields: [userId], references: [id])
  userId     String
  
  // The calculated amount this user owes [cite: 17, 20]
  amount     Float    
  
  // Metadata for complex splits
  percentage Float?   // Only used if splitType is PERCENTAGE
}